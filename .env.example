# Phase 01 config: development starts without DB/LLM; production requires real values.
# Copy to .env during implementation; .env is ignored. Never paste secrets into chat.
APP_ENV=development
PORT=8000
DATABASE_URL=
OPENAI_API_KEY=
# Select a model your account can access; smoke-test structured output before coding further.
OPENAI_MODEL=
JWT_SECRET=
JWT_ISSUER=ai-gateway
JWT_AUDIENCE=ai-gateway-clients
JWT_TTL_SECONDS=3600
RATE_LIMIT_HASH_SECRET=
AI_REQUESTS_PER_MINUTE=10
# Starting safety caps; adjust only within agreed budget and reviewer access requirements.
AI_REQUESTS_PER_USER_DAY=100
AI_REQUESTS_PER_GATEWAY_DAY=300
AUTH_REQUESTS_PER_IP_MINUTE=5
REQUEST_DEADLINE_SECONDS=30
LLM_DEADLINE_SECONDS=27
ATTEMPT_TIMEOUT_SECONDS=10
CONNECT_TIMEOUT_SECONDS=3
DATABASE_CHECK_TIMEOUT_SECONDS=5
MAX_PROVIDER_ATTEMPTS=3
SDK_MAX_RETRIES=0
CHAT_MAX_OUTPUT_TOKENS=512
ANALYZE_MAX_OUTPUT_TOKENS=1024
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARACTERS=40000
MAX_BODY_BYTES=65536
LOG_LEVEL=INFO
ALLOWED_ORIGINS=
# One-off seed command reads these; do not publish real passwords in source.
DEMO_USERNAME=reviewer
DEMO_PASSWORD=
SECOND_TEST_USERNAME=other-reviewer
SECOND_TEST_PASSWORD=
